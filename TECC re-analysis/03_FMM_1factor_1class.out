INPUT INSTRUCTIONS

  TITLE:  One-factor ordinal model, no classes;

  DATA:
     FILE IS final_data.dat;

  VARIABLE:
     NAMES = images music video book games camera create
        age educ exper ise dse urban rural statepk fullday
        days pdrec pdfreq pdutil;
     USEVARIABLES = images music video book games camera create;
     CATEGORICAL = images music video book games camera create;
     MISSING = ALL (-999);
     CLASSES = c(1);

  ANALYSIS:
     TYPE = MIXTURE;
     STARTS = 20 5;
     STITERATIONS = 20;
     ALGORITHM = INTEGRATION;
     INTEGRATION = 30;

  MODEL:
     %OVERALL%
     f BY images* music video book games camera create;
     f@1;

  OUTPUT:
     TECH1 TECH11;



*** WARNING in OUTPUT command
  TECH11 option is not available for TYPE=MIXTURE with only one class.
  Request for TECH11 is ignored.
   1 WARNING(S) FOUND IN THE INPUT INSTRUCTIONS




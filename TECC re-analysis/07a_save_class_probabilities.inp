TITLE:  Manual three-step, step 1: save class probabilities from the selected model;

DATA:
   FILE IS final_data.dat;

VARIABLE:
   NAMES = images music video book games camera create
      age educ exper ise dse urban rural statepk fullday
      days pdrec pdfreq pdutil;
   USEVARIABLES = images music video book games camera create;
   CATEGORICAL = images music video book games camera create;
   AUXILIARY = age educ exper ise dse urban rural statepk
      fullday days pdrec pdfreq pdutil;
   MISSING = ALL (-999);
   CLASSES = c(2);

ANALYSIS:
   TYPE = MIXTURE;
   STARTS = 500 100;
   STITERATIONS = 20;
   ALGORITHM = INTEGRATION;
   INTEGRATION = 30;

MODEL:
   %OVERALL%
   f BY images* music video book games camera create;
   f@1;

OUTPUT:
   TECH1;

SAVEDATA:
   FILE IS class_probs.dat;
   SAVE = CPROBABILITIES;
